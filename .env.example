# Server-side only. Never put the API key in Drupal configuration or browser JS.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
SITE_ID=evander-preview
# Browser origin permitted by CORS. For a React client this can differ from Drupal.
SITE_ORIGIN=https://evander-preview10.ddev.site
# Fixed authoritative Drupal tool origin, never supplied by a browser request.
DRUPAL_TOOL_BASE=https://evander-preview10.ddev.site
PORT=8180
MAX_MODEL_CALLS=4
MAX_TURN_TOKENS=12000
# Additional local certificate authority file if required. Never disable TLS verification.
# NODE_EXTRA_CA_CERTS=/path/to/rootCA.pem
