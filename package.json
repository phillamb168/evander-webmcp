{
  "name": "evander-webmcp-preview",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/reference-backend",
    "examples/react-drupal",
    "examples/standalone"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:php": "php tests/php/run.php",
    "test:chrome": "playwright test --config=tests/chrome.config.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "node scripts/package.mjs",
    "build": "node scripts/build.mjs",
    "example:standalone": "npm run dev --workspace=@evander-webmcp/example-standalone",
    "example:drupal": "npm run dev --workspace=@evander-webmcp/example-react-drupal",
    "backend": "node --env-file-if-exists=.env services/reference-backend/server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "happy-dom": "^20.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.3.7"
  }
}
